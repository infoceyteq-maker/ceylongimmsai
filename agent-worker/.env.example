# GIMMS Auto-Pilot worker — copy to .env in the worker's own deployment.
# NEVER commit the real file. Set these in Fly.io secrets / Railway variables /
# Render environment, not in the repository.

# Required. At least 24 characters. Must equal AGENT_WORKER_SECRET in Vercel.
WORKER_SECRET=

# Optional.
PORT=8080
MAX_CONCURRENT=2
MAX_DURATION_MS=240000
HEADLESS=1
# CHROME_PATH=/usr/bin/chromium
# USER_AGENT=Mozilla/5.0 (...) Chrome/141.0.0.0 Safari/537.36
# USER_DATA_DIR=/data/storage-state.json
