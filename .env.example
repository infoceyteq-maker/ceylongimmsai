# ============================================================================
# AI GIMMS Hub — environment variables
#
# Copy to .env.local for local development ONLY. Never commit .env.local.
# In production set these in: Vercel → Project → Settings → Environment Variables
# (choose Production + Preview). Never paste a value into chat or a GitHub issue.
#
# A variable left empty = that feature is OFF. Nothing fails open.
# ============================================================================

# ── Storage (existing) ───────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=info.ceyteq@gmail.com
HUB_STATE_TABLE=hub_state

# ── Owner identity (Phase 1) ─────────────────────────────────────────────────
# REQUIRED on a public production deployment. Without it, first-run registration is
# refused, so a stranger cannot claim the hub by loading /chat first.
# Generate one: openssl rand -hex 32
OWNER_BOOTSTRAP_TOKEN=

# Durable Owner record (open item #1). When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are
# both set, the Owner record and its sessions live in this Supabase table instead of the
# local JSON file, so a sign-in survives cold starts and redeploys.
# Leave empty to use the table name shown here; set a different name only if you renamed it.
OWNER_STATE_TABLE=gimms_owner_state

# Escape hatch: set to 1 ONLY on a throwaway/preview deployment where you accept
# that the first visitor can become Owner. Leave unset in production.
GIMMS_ALLOW_FIRST_RUN_CLAIM=

# ── Agent job storage (Phase 2) ──────────────────────────────────────────────
AGENT_JOBS_TABLE=gimms_agent_jobs

# ── Browser worker (Phase 2) ─────────────────────────────────────────────────
# The public URL of the worker deployed from agent-worker/ (no trailing slash).
AGENT_WORKER_URL=
# Must equal WORKER_SECRET in the worker's own environment. openssl rand -hex 32
AGENT_WORKER_SECRET=
# The public base URL of THIS app — used to build the worker's callback URL.
GIMMS_PUBLIC_URL=https://ai-gimms-hub.vercel.app

# ── Outbound policy (Phase 2) ────────────────────────────────────────────────
# Which platforms may perform an outbound action (posting/commenting).
# EMPTY BY DEFAULT AND THAT IS INTENTIONAL — see PHASE2-AGENT-ARCHITECTURE.md §7.
# Example (only after you have read §7 and accept the account risk):
#   AGENT_ALLOW_OUTBOUND=
# Confirms you have authority to act on the account. Required in addition to the above.
AGENT_OPERATOR_ATTESTED=

# ── Optional hardening ───────────────────────────────────────────────────────
# Set to 1 to disable every child-process probe (lib/exec-guard.ts) outright.
GIMMS_DISABLE_CHILD_PROCESS=

# ── Auto-Pilot v3 · Gmail (READ + DRAFT ONLY) ────────────────────────────────
# Create the OAuth client in Google Cloud Console (see docs/AUTOPILOT-MANUAL-SETUP.md §2).
# Scopes requested: gmail.readonly + gmail.compose. There is NO send code path.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Long-lived token from the consent flow. Treat like a password: env var only.
GMAIL_REFRESH_TOKEN=

# ── Auto-Pilot v3 · real-time voice ─────────────────────────────────────────
# Vendor-neutral broker endpoint that mints a SHORT-LIVED session token
# (OpenAI Realtime session endpoint, Vapi token endpoint, Retell web-call, …).
# The browser receives only the ephemeral token, never this API key.
AUTOPILOT_VOICE_SESSION_URL=
AUTOPILOT_VOICE_API_KEY=

# ── Auto-Pilot v3 · optional LLM intent classifier ──────────────────────────
# OFF by default. When enabled the model may only choose ONE id from the closed
# enum in lib/autopilot/intent.ts — it can never emit steps or tool calls.
AUTOPILOT_LLM_CLASSIFIER=
OPENAI_API_KEY=
AUTOPILOT_LLM_MODEL=gpt-4o-mini
# Only for an OpenAI-compatible gateway; leave empty for api.openai.com.
OPENAI_BASE_URL=

# ── Auto-Pilot v3 · Meta Marketing API (NOT IMPLEMENTED YET) ────────────────
# Reported as NOT_CONFIGURED / NOT_IMPLEMENTED until code exists. Never enables
# unattended budget or campaign changes — see docs/AUTOPILOT-ARCHITECTURE-V3.md §3.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
